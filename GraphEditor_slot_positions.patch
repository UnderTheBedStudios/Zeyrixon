+// Slot position from an optional per-slot fraction of the node rectangle (see Template::mInputPositions).
+static ImVec2 SlotPosFromFraction(const Node& node, const ImVec2& fraction, float factor)
+{
+    const ImVec2 size = node.mRect.GetSize() * factor;
+    return ImVec2(node.mRect.Min.x * factor + size.x * fraction.x,
+                  node.mRect.Min.y * factor + size.y * fraction.y);
+}
+
+// Which way a link should leave a slot: out of whichever edge the slot is closest to.
+// Without custom positions that is right for outputs and left for inputs, as it always was.
+static ImVec2 SlotLinkDirection(const ImVec2* positions, SlotIndex slotIndex, bool isOutput)
+{
+    if (!positions)
+        return ImVec2(isOutput ? 1.f : -1.f, 0.f);
+
+    const float dx = positions[slotIndex].x - 0.5f;
+    const float dy = positions[slotIndex].y - 0.5f;
+    if (fabsf(dy) > fabsf(dx))
+        return ImVec2(0.f, dy >= 0.f ? 1.f : -1.f);
+    return ImVec2(dx >= 0.f ? 1.f : -1.f, 0.f);
+}
