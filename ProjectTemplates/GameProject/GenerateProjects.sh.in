#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

# premake5.lua reads this too; it decides which Zeyrixon engine this game builds against.
export ZEYRIXON_DIR="${ZEYRIXON_DIR:-@ZEYRIXON_DIR@}"

PREMAKE_BIN="$ZEYRIXON_DIR/vendor/binary/premake5"
if [ -f "$PREMAKE_BIN" ] && [ ! -x "$PREMAKE_BIN" ]; then
    chmod +x "$PREMAKE_BIN"
fi

echo "Generating build files against engine at $ZEYRIXON_DIR"
"$PREMAKE_BIN" gmake
